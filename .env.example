# ---------------------------------------------------------------
# Root .env — used by scripts/db-setup.sh (sqlcmd) only.
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_SA_USER=sa
MSSQL_SA_PASSWORD=change-me

# Passwords for the three application logins created by db/05_logins.sql
# (must satisfy SQL Server password policy: 8+ chars, upper, lower, digit, symbol).
# Keep them in single quotes — '#' would otherwise start a comment.
NEXUS_APP_PASSWORD='App#Pass2026!'
NEXUS_AGENT_PASSWORD='Agent#Pass2026!'
NEXUS_ADMIN_PASSWORD='Admin#Pass2026!'

# Local LLM launcher (scripts/start-llm.sh) — llama.cpp + a GGUF model
LLAMA_SERVER_BIN=/path/to/llama.cpp/build/bin/llama-server
LLM_MODEL_PATH=/path/to/models/qwen2.5-3b-instruct-q4_k_m.gguf
