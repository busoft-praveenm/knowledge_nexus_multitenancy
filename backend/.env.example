# ---------------------------------------------------------------
# backend/.env — copy to .env. NEVER commit the real file.
# ---------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Demo auth: JWT signing secret (any long random string)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=NexusDemo
DB_TRUST_SERVER_CERT=true

# Three least-privilege logins created by db/05_logins.sql (must match root .env).
# Keep passwords in single quotes — '#' would otherwise start a comment.
DB_APP_USER=nexus_app
DB_APP_PASSWORD='App#Pass2026!'
DB_AGENT_USER=nexus_agent
DB_AGENT_PASSWORD='Agent#Pass2026!'
DB_ADMIN_USER=nexus_admin
DB_ADMIN_PASSWORD='Admin#Pass2026!'

# Local, free LLM — any OpenAI-compatible server, no API key:
#   llama.cpp : llama-server -m qwen2.5-3b-instruct-q4_k_m.gguf --jinja --port 8080   -> http://127.0.0.1:8080/v1
#   Ollama    : ollama serve && ollama pull qwen2.5:3b                                 -> http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen2.5-3b
LLM_TIMEOUT_MS=120000

# Agent tool guard-rails
AGENT_MAX_ROWS=100
AGENT_QUERY_TIMEOUT_MS=5000
AGENT_MAX_STEPS=5
